# ── Supabase (PostgreSQL) ─────────────────────────────────
# Supabase ダッシュボード → Project Settings → Database → Connection string
# [YOUR-PASSWORD] はプロジェクト作成時に設定した DB パスワードに置換する。
#
# DATABASE_URL : 実行時用。Transaction pooler（ポート 6543）+ pgbouncer
#   例: postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL   : マイグレーション/seed 用。Session pooler（ポート 5432）
#   例: postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=""
DIRECT_URL=""

# Auth.js（NextAuth v5）
AUTH_SECRET="openssl rand -base64 32 で生成した値"

# LINE Messaging API（公式アカウント・ライトプラン）
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""

# 日次Cron（入金リマインド）の保護。Vercel が Authorization: Bearer <値> を付与する
CRON_SECRET=""

# 公式アカウントの「友だち追加」URL（https://lin.ee/xxxx）。
# VITE_ 接頭辞のためブラウザに渡る（LINE連携カードの「案内文をコピー」で使用）。
VITE_LINE_ADD_FRIEND_URL=""

# ── GMOあおぞらネット銀行 API連携（No.153）──
# 本番: https://api.gmo-aozora.com / 開発(sunabar): https://stg-api.gmo-aozora.com
GMO_API_BASE="https://stg-api.gmo-aozora.com"
GMO_CLIENT_ID=""
GMO_CLIENT_SECRET=""
# 事前登録済みリダイレクトURI（例: https://<デプロイURL>/api/gmo/auth/callback）
GMO_REDIRECT_URI=""
# クライアント認証方式: basic（推奨・既定） or post
GMO_AUTH_METHOD="basic"
GMO_SCOPE="private:account private:virtual-account"
# 入出金明細取得APIのパス（照会系仕様書の受領後に設定）
GMO_DEPOSIT_PATH=""

# ── GMO Webhook（振込入金口座_入金明細通知）の受け口 ──
# 受信URL: https://<本番ドメイン>/api/gmo/webhook を GMO のイベント通知設定に登録する。
# 認証は HTTPS + Basic認証（docs/infra/gmo-proxy/構築手順書.md の設計）。
# ここを空のままにすると、IP制限も外した場合に 503 を返して受信しない（フェイルクローズ）。
GMO_WEBHOOK_USER=""
GMO_WEBHOOK_PASS=""
# 追加の共通シークレット（任意）。設定すると x-webhook-secret ヘッダーの一致を必須にする
GMO_WEBHOOK_SECRET=""
# 送信元IP制限。既定は有効。GMO配信元: 開発 18.182.233.135 / 本番 13.115.136.151
# 配信元が変わった場合のみ "0" にして無効化する
GMO_WEBHOOK_ENFORCE_IP="1"
# 上記に追加で許可するIP（カンマ区切り・任意）
GMO_WEBHOOK_ALLOW_IPS=""

# ── 固定IPプロキシ（Lightsail）── GMO側のIP許可制のため必須
# 構築済み（2026-07-17）: 本番 13.193.67.46 / 開発 18.182.181.135
# 本番: http://13.193.67.46:8888 / 開発: http://18.182.181.135:8888
GMO_PROXY_URL=""
GMO_PROXY_USER="gmoproxy"
GMO_PROXY_PASS=""

# ── メール送信（No.92/93）── どちらか一方のキーを設定
RESEND_API_KEY=""
SENDGRID_API_KEY=""
MAIL_FROM="司法書士法人第一法務事務所 <no-reply@example.com>"

# ── 受任資料の添付ファイル（Supabase Storage）──
# 未設定だと案件詳細の「受任資料」タブが 503 になり、写真やWordが開けない。
# 本番（Vercel）の Environment Variables にも同じ2つを入れること。
# SECRET_KEY は本番DBの全権鍵。リポジトリには絶対に置かない。
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
# 保存先のバケット名。未設定なら case-files
SUPABASE_BUCKET=""
