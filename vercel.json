{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hnd1"],
  "crons": [
    {
      "path": "/api/cron/payment-reminder",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/cases/:p*", "destination": "/api/data?__path=cases/:p*" },
    { "source": "/api/creditors/:p*", "destination": "/api/data?__path=creditors/:p*" },
    { "source": "/api/payments/:p*", "destination": "/api/data?__path=payments/:p*" },
    { "source": "/api/contact-histories/:p*", "destination": "/api/data?__path=contact-histories/:p*" },
    { "source": "/api/changes/:p*", "destination": "/api/data?__path=changes/:p*" },
    { "source": "/api/line/links/:p*", "destination": "/api/data?__path=line/links/:p*" },
    { "source": "/api/line/broadcast", "destination": "/api/data?__path=line/broadcast" },
    { "source": "/api/line/broadcast-history", "destination": "/api/data?__path=line/broadcast-history" },
    { "source": "/api/gmo/:p*", "destination": "/api/data?__path=gmo/:p*" },
    { "source": "/api/intake/:p*", "destination": "/api/data?__path=intake/:p*" },
    { "source": "/api/deposits/:p*", "destination": "/api/data?__path=deposits/:p*" },
    { "source": "/api/mail/:p*", "destination": "/api/data?__path=mail/:p*" },
    { "source": "/api/reminders/:p*", "destination": "/api/data?__path=reminders/:p*" },
    { "source": "/api/presence/:p*", "destination": "/api/data?__path=presence/:p*" },
    { "source": "/api/_diag", "destination": "/api/data?__path=_diag" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
