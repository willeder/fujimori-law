// 受任案件管理システム — 本実装用 Prisma スキーマ
// DB: PostgreSQL (Neon 想定) / ORM: Prisma
// 既存の client-mock/src/types/case.ts の型をリレーショナルに落とし込み、
// LINE 連携（userId 紐付け・通知ログ）と認証（Auth.js）テーブルを追加。
//
// 命名: モデル=PascalCase / フィールド=camelCase / テーブル=snake_case(@@map)
// 金額=Int（円・整数）/ 日付=DateTime @db.Date / 日時=DateTime

generator client {
  provider      = "prisma-client-js"
  // Vercel(AWS Lambda / Amazon Linux, Node18+→OpenSSL3) 実行環境向けエンジンを同梱。
  // これが無いと本番で「Query engine ... could not be found」→ FUNCTION_INVOCATION_FAILED。
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // 実行時はプーラー（Supabase: Transaction pooler 6543, pgbouncer）
  url       = env("DATABASE_URL")
  // マイグレーション/seed は直結相当（Supabase: Session pooler 5432）
  directUrl = env("DIRECT_URL")
}

// ============================================================
// 案件（依頼者）— 旧 Case 型を 1 テーブルに集約
// ============================================================
model Case {
  id           Int     @id @default(autoincrement())
  // kintone 等の外部ID（移行時の突合キー・ユニーク）
  externalId   String? @unique
  recordNumber Int?

  // --- 依頼者 基本情報 ---
  name                     String
  furigana                 String?
  phone                    String?
  lineUrl                  String?
  email                    String?
  postalCode               String?
  prefecture               String?
  address                  String?
  birthDate                DateTime? @db.Date
  age                      Int?
  gender                   String? // 男 / 女
  maritalStatus            String? // 既婚 / 未婚 / 離婚
  maidenName               String?
  children                 String?
  residenceType            String?
  rent                     Int?
  monthlyIncome            Int?
  payDay                   String?
  employmentType           String?
  cautionRank              String? // A / B / C
  correspondenceRequired   String?
  correspondenceHours      String?
  cohabitation             String?
  confidentialContact      String?
  emergencyContact         String?
  emergencyContactRelation String?
  previousAddress          String?
  payrollAccount           String?
  employerName             String?
  employerContact          String?
  employerAddress          String?
  previousEmployerName     String?
  previousEmployerContact  String?
  previousEmployerAddress  String?
  otherOfficeConsultation  String?
  paymentDelay             String?
  bicycleNote              String?
  pension                  String?

  // --- アポ・後確・面談 ---
  appointmentStaff         String?
  followUpStaff            String?
  interviewStaff           String?
  judicialScrivener        String?
  debtAdjustmentType       String? // 任意整理 / 自己破産 / 個人再生
  acceptanceRank           String? // A / B / C
  acceptanceDate           DateTime? @db.Date
  elapsedDays              Int?
  cAcceptancePromotionDate DateTime? @db.Date
  interviewMemo1           String?
  interviewMemo2           String?
  incomeExpenseMemo        String?

  // --- 債務情報 ---
  creditorCount      Int?
  declaredDebtAmount Int?
  totalDebtAmount    Int?
  preRequestPayment  Int?
  postRequestPayment Int?

  // --- 和解情報 ---
  settlementStatus           String? // 受任後ステータス
  settlementProposalDate     DateTime? @db.Date
  settlementCount            Int?
  postSettlementPaymentCount Int?
  plannedPaymentCount        Int?
  plannedAgentCount          Int?
  allSettlementDocSentDate   DateTime? @db.Date
  /// 辞任日（kintone 基本情報.csv の「辞任日」。411件で入力あり）
  resignationDate            DateTime? @db.Date

  // --- 報酬情報 ---
  normalFee              Int?
  officeFee              Int?
  installmentCount       Int?
  agentPayment           String?
  plannedPaymentFeeTotal Int?
  uncollectedFee         Int?

  // --- 入金情報（案件サマリ） ---
  firstPaymentDate                     DateTime? @db.Date
  firstPaymentWithinTenDays            String?
  firstPaymentAmount                   Int?
  monthlyPaymentDay                    String?
  basePaymentAmount                    Int?
  nextPaymentDate                      DateTime? @db.Date
  cumulativePaymentAmount              Int?
  cumulativePlannedPayment             Int?
  cumulativeFeeAllocation              Int?
  cumulativePlannedFeeAllocation       Int?
  cumulativePoolAllocation             Int?
  cumulativeRepaymentAllocation        Int?
  // 2026-08-07 追加。kintone「基本情報」にはあるが未移行だった累計値
  // （報酬・弁代・プールチェック一覧で使用）
  cumulativePlannedAgentFeeAllocation  Int? // 累)弁代報酬充当予定額
  cumulativeAgentFeeAllocation         Int? // 累)弁代報酬充当額
  cumulativePlannedPoolAllocation      Int? // 累)ﾌﾟｰﾙ充当予定額
  cumulativePlannedRepaymentAllocation Int? // 累)弁済充当予定額
  cumulativeHandlingFee                Int? // 累)手数料
  totalMinusPoolMinusRepayment         Int?
  notificationExcluded                 String? // 除外 / null
  vAccountBranch                       String?
  vAccountNumber                       String?

  // --- リマインド ---
  reminderDate     DateTime? @db.Date
  reminderTime     String?
  nextResponseDate DateTime? @db.Date
  responseTime     String?

  // --- メタ ---
  listCategory       String?
  listRegisteredDate DateTime? @db.Date
  acceptanceDocs     String?
  createdBy          String?
  updatedBy          String?
  // 最後に保存したセッション（タブ）の識別子。先勝ち保存の判定に使う。
  // アカウントではなくセッションで比較することで、同じアカウントの別ウィンドウ同士でも
  // 上書きを検知できる（旧: updatedBy のメール比較だったため同一アカウントは素通りしていた）
  updatedByClient    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // --- リレーション ---
  creditors        Creditor[]
  payments         Payment[]
  contactHistories ContactHistory[]
  lineLink         LineLink?
  notificationLogs LineNotificationLog[]
  files            CaseFile[]
  reminders        CaseReminder[]

  @@index([cautionRank])
  @@index([settlementStatus])
  @@index([name])
  @@map("cases")
}

// ============================================================
// 債権者（和解対象債権）
// ============================================================
model Creditor {
  id     Int  @id @default(autoincrement())
  caseId Int
  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  creditorName             String
  negotiationPartner       String?
  declaredAmount           Int?
  debtAmount               Int?
  expectedSettlement       Int?
  expectedSettlementAmount Int?
  expectedPaymentCount     Int?
  expectedFutureInterest   String?
  status                   String // 受任通知発送待ち / 受任対象外 / 和解済 / 弁済中 ...
  displayOrder             Int? // タブ/一覧の表示順（小さいほど左/上。受任→受任対象外の順で採番）
  check                    String?
  nextProcessDate          DateTime? @db.Date
  acceptanceNoticeSentDate DateTime? @db.Date
  debtInquiryArrivalDate   DateTime? @db.Date
  customerCode             String?
  contractDate             DateTime? @db.Date
  settlementProposalDate   DateTime? @db.Date
  settlementProposal       Int?
  responseStatus           String?
  settlementDate           DateTime? @db.Date
  settlementAmount         Int?
  settlementDebtAmount     Int?
  settlementContentComment String?
  reminder                 String?
  paymentStartMonth        String? // 支払開始日 YYYY-MM-DD（列名は従来踏襲・中身は年月日）
  paymentDay               Int? // 支払日（廃止予定。約定日は支払開始日から導出。互換のため残置）
  paymentCount             Int?
  firstPaymentAmount       Int?
  subsequentPaymentAmount  Int?
  finalPaymentAmount       Int?
  finalPaymentMonth        String? // 最終支払日 YYYY-MM-DD（列名は従来踏襲・中身は年月日）
  futureInterest           String?
  bankName                 String?
  financialInstitutionCode String?
  branchName               String?
  branchCode               String?
  accountType              String?
  accountNumber            String?
  accountHolder            String?
  designatedCode           String?
  repaymentTarget          String?

  payments Payment[]
  files    CreditorFile[]

  @@index([caseId])
  @@index([status])
  @@index([caseId, displayOrder])
  @@map("creditors")
}

// ============================================================
// 入金予定/実績（案件全体行 + 債権者別行）
// creditorId == null: 案件全体の入金明細（入金情報由来）
// creditorId 有り    : 当該債権者の弁済スケジュール
// ============================================================
model Payment {
  id     Int  @id @default(autoincrement())
  caseId Int
  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  creditorId               Int?
  creditor                 Creditor? @relation(fields: [creditorId], references: [id], onDelete: SetNull)
  creditorInstallmentIndex Int?

  plannedDate                DateTime? @db.Date
  plannedAmount              Int?
  plannedFeeAllocation       Int?
  plannedAgentFeeAllocation  Int?
  plannedPoolAllocation      Int?
  plannedRepaymentAllocation Int?
  actualDate                 DateTime? @db.Date
  actualAmount               Int?
  actualFeeAllocation        Int?
  actualAgentFeeAllocation   Int?
  actualPoolAllocation       Int?
  actualRepaymentAllocation  Int?
  handlingFee                Int? // 手数料（予定）
  repaymentCount             Int? // 社数（予定）
  // 実績側。kintone は予定と実績で別項目を持つ（数 / 振)手数料 / 弁済日）。
  // 以前は予定側の列を実績にも流用していたため、社数・手数料の集計が実態とずれていた。
  repaymentDate              DateTime? @db.Date // 弁済日
  actualRepaymentCount       Int? // 数（実績の社数）
  actualHandlingFee          Int? // 振)手数料（実績の手数料）
  cumulativePool             Int?
  // 入金情報サブテーブルのチェックボックス（kintone: check[check]）。
  // ビュー「受任後入金管理」の絞り込み条件に使われている。
  check                      String?

  @@index([caseId])
  @@index([creditorId])
  @@index([plannedDate])
  @@map("payments")
}

// ============================================================
// 接触履歴（依頼者 / 債権者）
// ============================================================
enum ContactTarget {
  CLIENT // 依頼者
  CREDITOR // 債権者
}

model ContactHistory {
  id     Int  @id @default(autoincrement())
  caseId Int
  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  contactDate  DateTime?     @db.Date
  contactTime  String?
  staff        String?
  tool         String? // LINE / 電話 / メール ...
  targetType   ContactTarget
  creditorName String? // 債権者接触のとき
  comment      String?       @db.Text // 改行を含む複数行コメント

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([targetType])
  @@map("contact_histories")
}

// ============================================================
// LINE 連携：依頼者の LINE userId 紐付け（登録コード方式）
// ============================================================
enum LineLinkStatus {
  PENDING // コード発行済・未連携
  LINKED // userId 紐付け済
  BLOCKED // ブロック/解除
}

model LineLink {
  id               Int            @id @default(autoincrement())
  caseId           Int            @unique
  case             Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  registrationCode String         @unique // 友だち追加後に送ってもらう一意コード
  lineUserId       String?        @unique // Webhook で取得
  status           LineLinkStatus @default(PENDING)
  codeExpiresAt    DateTime?
  linkedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([lineUserId])
  @@map("line_links")
}

// ============================================================
// LINE 連携セッション（トリガー語受信後の一時状態）
// ------------------------------------------------------------
// 「連携開始」等のトリガー語を送ったユーザーだけを一定時間ここに登録し、
// その間の発言のみを登録コードとして照合する。
// これが無いと、手動チャット中の通常会話にまで自動返信が飛ぶ。
// Vercel Functions はステートレスなためメモリではなく DB に保持する。
// ============================================================
model LineCodeSession {
  lineUserId String   @id // LINE ユーザーID（連携前なので案件とは未紐付け）
  attempts   Int      @default(0) // 入力ミス回数。上限超過でセッション終了
  expiresAt  DateTime // この時刻を過ぎたらコードとして受け付けない
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
  @@map("line_code_sessions")
}

// ============================================================
// LINE 通知ログ（push 配信の履歴・冪等性）
// ============================================================
enum NotificationType {
  PAYMENT_REMINDER // 入金予定リマインド（旧・汎用。後方互換のため残置）
  PAYMENT_REMINDER_3D // 入金催促：支払期日の3日前
  PAYMENT_REMINDER_1D // 入金催促：支払期日の前日
  PAYMENT_REMINDER_0D_1 // 入金催促：当日1回目
  PAYMENT_REMINDER_0D_2 // 入金催促：当日2回目（16:00時点で未入金）
  DEPOSIT_CONFIRM // 入金確認
  DEADLINE_ALERT // 期限アラート
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model LineNotificationLog {
  id                  Int                @id @default(autoincrement())
  caseId              Int
  case                Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type                NotificationType
  scheduledDate       DateTime           @db.Date
  sentAt              DateTime?
  status              NotificationStatus @default(PENDING)
  recipientLineUserId String?
  messageContent      String             @db.Text
  errorMessage        String?
  createdAt           DateTime           @default(now())

  // 同一案件・同一予定日・同一種別の二重送信防止
  @@unique([caseId, scheduledDate, type])
  @@index([status])
  @@map("line_notification_logs")
}

// ============================================================
// 認証（Auth.js / 事務所スタッフ）
// ============================================================
enum UserRole {
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE // 有効
  DISABLED // 無効化（ログイン不可・ログは保持）
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String? // Credentials 認証時（scrypt）
  image         String?
  role          UserRole   @default(STAFF)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // 監査・変更履歴（実行者として）
  auditLogs       AuditLog[]  @relation("AuditActor")
  changeLogs      ChangeLog[] @relation("ChangeActor")
  revertedChanges ChangeLog[] @relation("ChangeReverter")

  // 保存した絞り込み条件（作成者として）
  savedFilters SavedFilter[] @relation("SavedFilterOwner")

  @@index([role])
  @@index([status])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// 行動ログ（監査ログ）：誰が・いつ・何をしたか
// ============================================================
enum AuditAction {
  LOGIN // ログイン成功
  LOGIN_FAILED // ログイン失敗
  LOGOUT // ログアウト
  CREATE // 作成
  UPDATE // 更新
  DELETE // 削除
  VIEW // 閲覧（機微データ）
  EXPORT // エクスポート/出力
}

model AuditLog {
  id         BigInt      @id @default(autoincrement())
  // 実行者。ユーザー削除後もログを残すため任意参照＋メール文字列を保存
  actorId    String?
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String? // 実行時のメール（スナップショット）
  action     AuditAction
  // 対象（例: entity="User" entityId="<id>"）。横断検索用に文字列で保持
  entity     String?
  entityId   String?
  summary    String? // 人間可読の要約（例:「ロールを STAFF→ADMIN に変更」）
  metadata   Json? // 補足（任意の構造化情報）
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// 変更履歴：フィールド単位の before/after と revert（元に戻す）
// ============================================================
enum ChangeAction {
  CREATE
  UPDATE
  DELETE
}

model ChangeLog {
  id           BigInt       @id @default(autoincrement())
  actorId      String?
  actor        User?        @relation("ChangeActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail   String?
  entity       String // 例: "User"
  entityId     String // 変更対象の主キー
  action       ChangeAction
  before       Json? // 変更前スナップショット（DELETE/UPDATE）
  after        Json? // 変更後スナップショット（CREATE/UPDATE）
  // revert（元に戻す）
  reverted     Boolean      @default(false)
  revertedAt   DateTime?
  revertedById String?
  revertedBy   User?        @relation("ChangeReverter", fields: [revertedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("change_logs")
}

// ============================================================
// 編集中プレゼンス：同一レコードを開いている他ユーザーの検知（編集中ポップアップ用）
// クライアントが滞在中にハートビートで upsert し、離脱時に削除。TTL超過は自動掃除。
// ============================================================
model EditPresence {
  id           Int       @id @default(autoincrement())
  entity       String // 例: "Case"
  entityId     Int
  // タブ単位の識別子。これで識別することで、同じアカウントを別ウィンドウで開いている
  // 場合も「別のセッション」として検知できる（旧: email をキーにしていたため検知不可だった）
  clientId     String
  email        String // 編集中ユーザーのメール（表示と同一アカウント判定に使う）
  name         String    @default("") // 表示名（アカウント名）
  editing      Boolean   @default(false) // 編集中フラグ（閲覧のみ=false）
  // 編集を開始した時刻。これが最も早いセッションがロック保持者（先着優先）
  editingSince DateTime?
  startedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([entity, entityId, clientId])
  @@index([entity, entityId])
  @@map("edit_presences")
}

// GMOあおぞらAPI連携のトークン（1行運用）。No.153
model GmoApiToken {
  id           Int       @id @default(autoincrement())
  accessToken  String?
  refreshToken String?
  scope        String?
  expiresAt    DateTime?
  pendingState String? // 認可フロー中の state（CSRF対策）
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("gmo_api_tokens")
}

// GMOあおぞらAPI の Webhook（振込入金口座_入金明細通知）の受信記録。
// 目的は3つ:
//   1. 二重反映の防止（eventKey で一意）
//   2. 反映できなかった通知を後から人が見て手当てできるようにする
//   3. 仕様書受領前でも生ペイロードを保全し、項目名が判明したら再処理できるようにする
model GmoWebhookEvent {
  id          Int       @id @default(autoincrement())
  /**
   * 通知の一意キー。明細IDが取れればそれ、取れなければ本文のSHA-256
   */
  eventKey    String    @unique
  /**
   * 通知種別（ペイロードから取れた場合のみ）
   */
  eventType   String?
  sourceIp    String?
  /**
   * 受信した生JSON（項目名が仕様と違っても失われないように丸ごと保存）
   */
  payload     Json
  /**
   * received / applied / no-target / unparsed / rejected / failed
   */
  status      String    @default("received")
  /**
   * 抽出できた明細件数
   */
  parsedRows  Int       @default(0)
  /**
   * 実際に入金予定へ反映した件数
   */
  reflected   Int       @default(0)
  /**
   * 人向けの結果メッセージ
   */
  message     String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([receivedAt])
  @@index([status])
  @@map("gmo_webhook_events")
}

// 債権者資料（各社タブのファイル格納）。No.8
model CreditorFile {
  id         Int      @id @default(autoincrement())
  creditorId Int
  creditor   Creditor @relation(fields: [creditorId], references: [id], onDelete: Cascade)
  name       String
  mime       String   @default("application/octet-stream")
  size       Int
  data       Bytes
  uploadedBy String   @default("")
  createdAt  DateTime @default(now())

  @@index([creditorId])
  @@map("creditor_files")
}

// ============================================================
// 案件の添付ファイル（kintone の「相談票添付」「和解ファイル」）
// ============================================================
// 実体は Supabase Storage（バケット case-files）に置き、DBには置き場所だけ持つ。
// 34,477件・26.3GB あるため creditor_files のように Bytes 列へ入れると
// DB容量・バックアップ・取得速度のいずれも成り立たない。
model CaseFile {
  id     Int  @id @default(autoincrement())
  caseId Int
  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /**
   * kintone のフィールド名。「相談票添付」または「和解ファイル」
   */
  field String
  /**
   * 表示用のファイル名（kintone 上の名前をそのまま持つ）
   */
  name  String
  mime  String @default("application/octet-stream")
  size  Int

  /**
   * Supabase Storage 上のキー。例: cases/118823E/和解ファイル/<fileKey>.jpg
   */
  storagePath    String  @unique
  /**
   * 移行元 kintone の fileKey。再実行時の突合・重複防止に使う
   */
  kintoneFileKey String? @unique

  uploadedBy String   @default("")
  createdAt  DateTime @default(now())

  @@index([caseId])
  @@index([caseId, field])
  @@map("case_files")
}

// ============================================================
// リマインド（案件ごとの「いつ・何をする」）
// ============================================================
// kintone では和解対象債権のサブテーブルに債権者名「★リマインド」の行を作り、
//   次回処理日時 = いつやるか / 交渉相手の欄 = やること
// として運用していた。債権者の行に混ざっているため債権社数の集計が狂うので、
// こちらでは独立した表として持つ。
// 移行対象は中身のある 334 行・296 案件（残り1,083行は債権者名だけの空枠）。
model CaseReminder {
  id     Int  @id @default(autoincrement())
  caseId Int
  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /**
   * 期日。kintone の「次回処理日時」
   */
  dueDate DateTime? @db.Date
  /**
   * やること。kintone では「交渉相手」の欄に書かれていた
   */
  body    String
  /**
   * 対応済み。kintone の check 列に相当
   */
  done    Boolean   @default(false)
  doneAt  DateTime?
  doneBy  String?

  /**
   * 移行由来か手入力かの区別（kintone-migration / 空欄＝画面から追加）
   */
  source String @default("")

  createdBy String   @default("")
  updatedBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([dueDate])
  @@index([done, dueDate])
  @@map("case_reminders")
}

// メール送信履歴（No.92/93）
model EmailLog {
  id         Int      @id @default(autoincrement())
  caseId     Int?
  toAddress  String
  subject    String
  body       String
  status     String // SENT / FAILED
  error      String?
  provider   String   @default("")
  providerId String?
  sentBy     String   @default("")
  createdAt  DateTime @default(now())

  @@index([caseId])
  @@index([createdAt])
  @@map("email_logs")
}

// ============================================================
// 保存した絞り込み条件（一覧の検索条件を名前を付けて保存・共有する）
// ------------------------------------------------------------
// 一覧画面で組んだ検索条件・並び順に名前を付けて保存し、
// SHARED なら全ユーザーが、PRIVATE なら作成者本人だけが呼び出せる。
// 編集・削除は「作成者本人」または ADMIN のみ（API側で判定）。
// ============================================================
enum SavedFilterScope {
  SHARED // 全ユーザーで共有
  PRIVATE // 作成者本人のみ
}

model SavedFilter {
  id          String           @id @default(cuid())
  // 対象画面。将来ほかの一覧でも使えるようにキーで分ける（例: caseList）
  target      String           @default("caseList")
  name        String
  description String?
  scope       SavedFilterScope @default(SHARED)
  // 検索条件・並び順の実体（画面ごとのスキーマは src/types/savedFilter.ts）
  payload     Json
  // 表示順（小さいほど上。同値なら作成日時順）
  sortOrder   Int              @default(0)

  ownerId String
  owner   User   @relation("SavedFilterOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([target, scope])
  @@index([ownerId])
  @@map("saved_filters")
}
